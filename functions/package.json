{
  "name": "lukes-picks-functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src scripts test --max-warnings=0",
    "test": "vitest run --exclude test/firestore.rules.test.ts --exclude test/emulator.integration.test.ts",
    "test:rules": "cd .. && firebase emulators:exec --project demo-lukes-picks-local --only firestore \"npm --prefix functions run test:rules:direct\"",
    "test:rules:direct": "vitest run test/firestore.rules.test.ts",
    "test:integration": "npm run build && cd .. && firebase emulators:exec --project demo-lukes-picks-local --only auth,firestore,functions \"npm --prefix functions run test:integration:direct\"",
    "test:integration:direct": "vitest run test/emulator.integration.test.ts",
    "test:browser": "tsx test/browser-emulator.e2e.ts",
    "seed": "tsx scripts/seed-emulator.ts"
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/node": "22.19.15",
    "eslint": "9.39.2",
    "firebase": "12.9.0",
    "firebase-tools": "15.24.0",
    "playwright-core": "1.62.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    }
  }
}
